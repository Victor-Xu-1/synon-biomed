{
  "schemaVersion": 1,
  "id": "system-runtime-discovery",
  "contracts": [
    {"kind": "service", "name": "getModels"},
    {"kind": "service", "name": "getCurrentUser"},
    {"kind": "service", "name": "getEnvironmentStatus"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "models",
      "method": "GET",
      "path": "/api/models",
      "headers": {"Origin": "${origin}", "X-Synon-User-Id": "local-dev"},
      "expectedStatus": [200]
    },
    {
      "name": "current-user",
      "method": "GET",
      "path": "/api/me",
      "headers": {"Origin": "${origin}", "X-Synon-User-Id": "local-dev"},
      "expectedStatus": [200]
    },
    {
      "name": "environment-status",
      "method": "GET",
      "path": "/api/environments/status",
      "headers": {"Origin": "${origin}", "X-Synon-User-Id": "local-dev"},
      "expectedStatus": [200]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/2/response/body/email",
    "/steps/2/response/body/provider",
    "/steps/2/response/body/has_api_key",
    "/steps/2/response/body/shared_api_key",
    "/steps/2/response/body/auth_mode",
    "/steps/3/response/body/environments",
    "/steps/3/response/body/conda_disabled_reason"
  ],
  "redactions": []
}
