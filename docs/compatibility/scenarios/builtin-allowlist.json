{
  "schemaVersion": 1,
  "id": "builtin-allowlist",
  "contracts": [
    {"kind": "service", "name": "getBuiltinAllowlist"},
    {"kind": "service", "name": "setBuiltinAllowlistDisabled"},
    {"kind": "service", "name": "setBuiltinAllowlistDisabledGroups"},
    {"kind": "service", "name": "markAllowlistOnboardingSeen"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "get-initial-builtin-allowlist",
      "method": "GET",
      "path": "/api/preferences/builtin-allowlist",
      "expectedStatus": [200]
    },
    {
      "name": "disable-domain",
      "method": "PUT",
      "path": "/api/preferences/builtin-allowlist/disabled",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"disabled": ["*.ncbi.nlm.nih.gov"]},
      "expectedStatus": [200]
    },
    {
      "name": "disable-group",
      "method": "PUT",
      "path": "/api/preferences/builtin-allowlist/disabled-groups",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"disabledGroups": ["clinical"]},
      "expectedStatus": [200]
    },
    {
      "name": "mark-onboarding-seen",
      "method": "POST",
      "path": "/api/preferences/builtin-allowlist/onboarding-seen",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {},
      "expectedStatus": [200]
    },
    {
      "name": "get-updated-builtin-allowlist",
      "method": "GET",
      "path": "/api/preferences/builtin-allowlist",
      "expectedStatus": [200]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/1/response/body/activeKernelCount",
    "/steps/5/response/body/activeKernelCount"
  ],
  "redactions": []
}
