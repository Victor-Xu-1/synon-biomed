{
  "schemaVersion": 1,
  "id": "mcp-server-lifecycle",
  "contracts": [
    {"kind": "service", "name": "listCustomMCPServers"},
    {"kind": "service", "name": "getMcpAttachmentCountsByAgent"},
    {"kind": "service", "name": "getCustomMCPServer"},
    {"kind": "service", "name": "createCustomMCPServer"},
    {"kind": "service", "name": "updateCustomMCPServer"},
    {"kind": "service", "name": "deleteCustomMCPServer"},
    {"kind": "service", "name": "attachMCPToAgents"},
    {"kind": "service", "name": "attachMCPToAllAgents"},
    {"kind": "service", "name": "detachMCPFromAgent"},
    {"kind": "service", "name": "detachMCPFromAllAgents"}
  ],
  "steps": [
    {"name": "csrf", "method": "GET", "path": "/api/csrf", "headers": {"Origin": "${origin}"}, "expectedStatus": [204]},
    {"name": "create-research-agent", "method": "POST", "path": "/api/agents", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "body": {"name": "mcp_research", "displayName": "MCP Research", "description": "MCP lifecycle fixture", "systemPrompt": "Research with attached tools.", "skillNames": [], "unrestricted": false, "enabled": true}, "expectedStatus": [200]},
    {"name": "create-writer-agent", "method": "POST", "path": "/api/agents", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "body": {"name": "mcp_writer", "displayName": "MCP Writer", "description": "MCP lifecycle fixture", "systemPrompt": "Write with attached tools.", "skillNames": [], "unrestricted": false, "enabled": true}, "expectedStatus": [200]},
    {"name": "list-empty", "method": "GET", "path": "/api/mcp-servers", "headers": {"X-Synon-User-Id": "local"}, "expectedStatus": [200]},
    {"name": "counts-empty", "method": "GET", "path": "/api/mcp-servers/attachment-counts", "headers": {"X-Synon-User-Id": "local"}, "expectedStatus": [200]},
    {"name": "create-server", "method": "POST", "path": "/api/mcp-servers", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "body": {"name": "evidence-oracle", "description": "MCP lifecycle fixture", "url": "https://1.1.1.1/mcp", "transport": "streamable_http"}, "expectedStatus": [201], "capture": {"server": "/id"}},
    {"name": "get-server", "method": "GET", "path": "/api/mcp-servers/${capture:server}", "headers": {"X-Synon-User-Id": "local"}, "expectedStatus": [200]},
    {"name": "update-server", "method": "PATCH", "path": "/api/mcp-servers/${capture:server}", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "body": {"name": "evidence-updated", "description": "Updated fixture"}, "expectedStatus": [200]},
    {"name": "attach-selected", "method": "POST", "path": "/api/mcp-servers/${capture:server}/attach", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "body": {"agent_names": ["MCP_RESEARCH"]}, "expectedStatus": [200]},
    {"name": "counts-selected", "method": "GET", "path": "/api/mcp-servers/attachment-counts", "headers": {"X-Synon-User-Id": "local"}, "expectedStatus": [200]},
    {"name": "attach-all", "method": "POST", "path": "/api/mcp-servers/${capture:server}/attach-all", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "expectedStatus": [200]},
    {"name": "counts-all", "method": "GET", "path": "/api/mcp-servers/attachment-counts", "headers": {"X-Synon-User-Id": "local"}, "expectedStatus": [200]},
    {"name": "detach-selected", "method": "DELETE", "path": "/api/mcp-servers/${capture:server}/agents/MCP_RESEARCH", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "expectedStatus": [200]},
    {"name": "detach-all", "method": "DELETE", "path": "/api/mcp-servers/${capture:server}/detach-all", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "expectedStatus": [200]},
    {"name": "delete-server", "method": "DELETE", "path": "/api/mcp-servers/${capture:server}", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "expectedStatus": [200]},
    {"name": "get-deleted", "method": "GET", "path": "/api/mcp-servers/${capture:server}", "headers": {"X-Synon-User-Id": "local"}, "expectedStatus": [404]}
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/1/response/body",
    "/steps/2/response/body",
    "/steps/5/response/body/id",
    "/steps/5/response/body/created_at",
    "/steps/5/response/body/updated_at",
    "/steps/6/request/path",
    "/steps/6/response/body/id",
    "/steps/6/response/body/created_at",
    "/steps/6/response/body/updated_at",
    "/steps/7/request/path",
    "/steps/7/response/body/id",
    "/steps/7/response/body/created_at",
    "/steps/7/response/body/updated_at",
    "/steps/8/request/path",
    "/steps/8/response/body/mcp_server_id",
    "/steps/10/request/path",
    "/steps/10/response/body/mcp_server_id",
    "/steps/12/request/path",
    "/steps/12/response/body/mcp_server_id",
    "/steps/13/request/path",
    "/steps/13/response/body/mcp_server_id",
    "/steps/14/request/path",
    "/steps/14/response/body/mcp_server_id",
    "/steps/15/request/path",
    "/steps/15/response/body/detail"
  ],
  "redactions": []
}
