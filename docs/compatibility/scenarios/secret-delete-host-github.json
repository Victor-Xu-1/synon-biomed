{
  "schemaVersion": 1,
  "id": "secret-delete-host-github",
  "contracts": [
    {"kind": "service", "name": "deleteSecret"},
    {"kind": "service", "name": "probeHostGithubCredential"},
    {"kind": "service", "name": "useHostGithubCredential"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "reject-missing-secret-delete",
      "method": "DELETE",
      "path": "/api/secrets/missing-secret",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "expectedStatus": [404]
    },
    {
      "name": "create-secret-for-delete",
      "method": "POST",
      "path": "/api/secrets",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"provider": "generic", "name": "delete_me", "value": "delete-value"},
      "expectedStatus": [201],
      "capture": {"delete_id": "/id"}
    },
    {
      "name": "delete-secret",
      "method": "DELETE",
      "path": "/api/secrets/${capture:delete_id}",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "expectedStatus": [200]
    },
    {
      "name": "list-after-delete",
      "method": "GET",
      "path": "/api/secrets",
      "expectedStatus": [200]
    },
    {
      "name": "probe-without-host-github",
      "method": "GET",
      "path": "/api/credentials/github/host-probe",
      "expectedStatus": [200]
    },
    {
      "name": "reject-use-without-host-github",
      "method": "POST",
      "path": "/api/credentials/github/use-host",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {},
      "expectedStatus": [404]
    },
    {
      "name": "create-github-secret",
      "method": "POST",
      "path": "/api/secrets",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"provider": "github", "credentials": {"token": "github-existing-token"}},
      "expectedStatus": [201]
    },
    {
      "name": "probe-after-configured",
      "method": "GET",
      "path": "/api/credentials/github/host-probe",
      "expectedStatus": [200]
    },
    {
      "name": "reject-duplicate-host-use",
      "method": "POST",
      "path": "/api/credentials/github/use-host",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {},
      "expectedStatus": [409]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/2/response/body/id",
    "/steps/2/response/body/created_at",
    "/steps/2/response/body/updated_at",
    "/steps/3/request/path",
    "/steps/3/response/body/id",
    "/steps/7/response/body/id",
    "/steps/7/response/body/created_at",
    "/steps/7/response/body/updated_at"
  ],
  "redactions": []
}
