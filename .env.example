# Synon Biomed v0.1.1 safe local defaults.
# Copy this file to .env, fill only the integrations you use, then load it with:
#   set -a; source .env; set +a

# Core runtime. Loopback is the safe default. A non-loopback SYNON_ADDRESS is
# rejected unless password authentication is configured, or an external web
# identity provider is configured together with an exact HTTPS public origin.
SYNON_ADDRESS=127.0.0.1:8765
SYNON_HOME=
SYNON_CONFIG=
SYNON_DATA_DIR_CONTROL=
SYNON_WORKING_DIR=
SYNON_CONDA_HOME=
SYNON_CONDA_ENVS_PATH=
SYNON_NETWORK_ALLOWED_DOMAINS=
SYNON_NETWORK_DENIED_DOMAINS=
SYNON_NETWORK_PROXY=
SYNON_NETWORK_CA_BUNDLE=
# auto (default), strict, or relaxed. An unrecognized value fails closed by
# falling through to the configured/automatic posture.
SYNON_MCP_X509_STRICT=auto
SYNON_PLUGIN_DIRS=
SYNON_SKILL_DIRS=

# Agent runner. Workspace mode requires an enabled active saved model provider.
SYNON_RUNNER_ENABLED=true
SYNON_RUNNER_ID=synon-go-runner
SYNON_RUNNER_PROVIDER=workspace
SYNON_RUNNER_COMMAND=
SYNON_RUNNER_ARGS_JSON=[]
SYNON_RUNNER_CHAT_ENDPOINT=
SYNON_RUNNER_CHAT_API_KEY=
SYNON_RUNNER_CHAT_MODEL=
SYNON_RUNNER_CHAT_SYSTEM_PROMPT=
SYNON_RUNNER_CHAT_TOOLS=
SYNON_RUNNER_CHAT_TIMEOUT_SECONDS=120
SYNON_RUNNER_CHAT_TOOL_ROUND_LIMIT=64
SYNON_RUNNER_CHAT_MAX_ATTEMPTS=4
SYNON_RUNNER_COMMAND_TIMEOUT_SECONDS=600
SYNON_RUNNER_POLL_INTERVAL_MS=1000
SYNON_RUNNER_LEASE_TTL_SECONDS=300
SYNON_RUNNER_REPLAY_LIMIT=200
SYNON_RUNNER_OUTPUT_LIMIT_BYTES=1048576

# Optional compact summarizer
SYNON_COMPACT_SUMMARIZER_ENDPOINT=
SYNON_COMPACT_SUMMARIZER_API_KEY=
SYNON_COMPACT_SUMMARIZER_MODEL=
SYNON_COMPACT_SUMMARIZER_TIMEOUT_SECONDS=120
SYNON_COMPACT_SUMMARIZER_MAX_ATTEMPTS=2

# Shared Web and Synon Link authentication. Leave both credentials blank only
# for a trusted loopback-only development runtime. Web and Link sessions use
# separate scopes even though they share these configured operator credentials.
SYNON_LINK_AUTH_USERNAME=
SYNON_LINK_AUTH_PASSWORD=
SYNON_LINK_AUTH_SESSION_TTL_MINUTES=2880
# Optional external web sign-in. Provider callbacks are handled server-side;
# provider tokens are validated there and are never persisted in frontend
# storage. Leave the public origin blank for a loopback-only deployment.
SYNON_AUTH_PUBLIC_BASE_URL=
SYNON_AUTH_GOOGLE_CLIENT_ID=
SYNON_AUTH_GOOGLE_CLIENT_SECRET=
# Sign in with Apple requires a Services ID, Team ID, Key ID, and private key.
# Supply the key by absolute file path or Base64; raw multiline environment
# values are intentionally rejected. The callback is:
#   ${SYNON_AUTH_PUBLIC_BASE_URL}/api/auth/oidc/apple/callback
SYNON_AUTH_APPLE_CLIENT_ID=
SYNON_AUTH_APPLE_TEAM_ID=
SYNON_AUTH_APPLE_KEY_ID=
SYNON_AUTH_APPLE_PRIVATE_KEY_FILE=
SYNON_AUTH_APPLE_PRIVATE_KEY_B64=
# WeChat Open Platform website-app login is separate from the message-channel
# WECHAT_* credentials below. The callback is:
#   ${SYNON_AUTH_PUBLIC_BASE_URL}/api/auth/oauth/wechat/callback
SYNON_AUTH_WECHAT_APP_ID=
SYNON_AUTH_WECHAT_APP_SECRET=
SYNON_LINK_SERVER_URL=http://127.0.0.1:8765
SYNON_LINK_USER_ID=
SYNON_DESKTOP_FILE_OPEN_ARGS_JSON=[]

# Message channels. Keep credentials blank for unused channels.
SYNON_ENABLED_ADAPTERS=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_ACCESS_TOKEN=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_DOMAIN=
WECHAT_ACCOUNT_ID=
WECHAT_BOT_TOKEN=
WECHAT_BASE_URL=https://ilinkai.weixin.qq.com
WECHAT_USER_ID=
WECHAT_POLL_INTERVAL_MS=1000

# Live message delivery verification targets
WECHAT_LIVE_SMOKE_USER_ID=
FEISHU_LIVE_SMOKE_CHAT_ID=
FEISHU_LIVE_SMOKE_OPEN_ID=
SYNON_LIVE_IM_RUNTIME_URL=http://127.0.0.1:8765
SYNON_LIVE_IM_REQUIRE_ALL=false
SYNON_LIVE_IM_SMOKE_MESSAGE=
SYNON_LIVE_IM_SMOKE_TIMEOUT_SECONDS=30

# Optional protocol integrations
SYNON_MCP_CONFIG=
SYNON_MCP_CONFIG_JSON=
SYNON_MCP_TIMEOUT_SECONDS=120
SYNON_MCP_SDK_BRIDGE_COMMAND=
SYNON_MCP_SDK_BRIDGE_ARGS_JSON=[]
SYNON_LSP_CONFIG=
SYNON_LSP_CONFIG_JSON=
SYNON_LSP_TIMEOUT_SECONDS=30
SYNON_WEBSEARCH_MODE=
SYNON_WEBSEARCH_ENDPOINT=
SYNON_WEBSEARCH_GO=true
# Optional source-only fallback. It is used only when explicitly configured.
# Example: /absolute/source/scripts/optional/websearch.py
SYNON_WEBSEARCH_SCRIPT=
SYNON_WEBSEARCH_PYTHON=

# Optional compute integrations
SYNON_KERNEL_PYTHON=
SYNON_KERNEL_ASSET_ROOT=
SYNON_MODAL_CONFIG_PATH=
SYNON_MODAL_RUNTIME_PYTHON=
SYNON_MODAL_RUNTIME_SCRIPT=
SYNON_MODAL_PROVIDER_PATH=
SYNON_MODAL_LIFECYCLE_PYTHON=
SYNON_MODAL_LIFECYCLE_SCRIPT=
# Feedback and telemetry
OPERON_SERVICE_URL=
SYNON_FEEDBACK_TOKEN=
SYNON_FEEDBACK_BETA=
SYNON_FEEDBACK_DISABLED=false
SYNON_DISABLE_TELEMETRY=false
SYNON_TUI_BASE_URL=http://127.0.0.1:8765
SYNON_TUI_HISTORY=
SYNON_TUI_RUNNER_ID=synon-go-runner
SYNON_TUI_EDITOR=
# Optional explicit static Web asset directory. A packaged install discovers
# the adjacent web/ directory automatically.
SYNON_WEB_ROOT=
