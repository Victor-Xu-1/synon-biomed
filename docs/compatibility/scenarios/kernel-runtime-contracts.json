{
  "schemaVersion": 1,
  "id": "kernel-runtime-contracts",
  "contracts": [
    {"kind": "event", "name": "pong"},
    {"kind": "event", "name": "execution_cell_update"},
    {"kind": "event", "name": "kernel_terminal_ack"},
    {"kind": "query", "name": "sessionKernels"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "create-project",
      "method": "POST",
      "path": "/api/projects",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"name": "Kernel Runtime Oracle", "find_or_create": true},
      "expectedStatus": [200, 201],
      "capture": {"project": "/project_id"}
    },
    {
      "name": "submit-root-frame",
      "method": "POST",
      "path": "/api/projects/${capture:project}/request",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {
        "input_data": {"request": "Create an isolated root for kernel runtime coverage."},
        "target_agent": "OPERON",
        "intent_id": "00000000-0000-4000-8000-000000000304"
      },
      "expectedStatus": [200],
      "capture": {"root": "/root_frame_id"}
    },
    {
      "name": "session-kernels",
      "method": "GET",
      "path": "/api/frames/${capture:root}/kernels",
      "expectedStatus": [200]
    },
    {
      "name": "terminal-without-live-kernel",
      "method": "POST",
      "path": "/api/frames/${capture:root}/kernel-exec",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {
        "language": "python",
        "environment": "python",
        "code": "print('kernel-oracle')"
      },
      "expectedStatus": [400, 404, 409]
    }
  ],
  "maxBodyBytes": 1048576,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/1/response/body/project_id",
    "/steps/1/response/body/created_at",
    "/steps/1/response/body/updated_at",
    "/steps/2/request/path",
    "/steps/2/response/body/frame_id",
    "/steps/2/response/body/root_frame_id",
    "/steps/3/request/path",
    "/steps/4/request/path"
  ],
  "redactions": []
}
