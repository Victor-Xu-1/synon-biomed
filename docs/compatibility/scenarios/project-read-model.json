{
  "schemaVersion": 1,
  "id": "project-read-model",
  "contracts": [
    {"kind": "service", "name": "listProjects"},
    {"kind": "service", "name": "getProject"},
    {"kind": "service", "name": "getDashboard"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "create-project",
      "method": "POST",
      "path": "/api/projects",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {
        "name": "Project Read Oracle",
        "description": "read model fixture",
        "find_or_create": true
      },
      "expectedStatus": [200],
      "capture": {"projectId": "/project_id"}
    },
    {
      "name": "create-frame",
      "method": "POST",
      "path": "/api/frames",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"project_id": "${capture:projectId}"},
      "expectedStatus": [201]
    },
    {
      "name": "list-projects",
      "method": "GET",
      "path": "/api/projects?limit=1&offset=0",
      "expectedStatus": [200]
    },
    {
      "name": "get-project",
      "method": "GET",
      "path": "/api/projects/${capture:projectId}",
      "expectedStatus": [200]
    },
    {
      "name": "get-dashboard",
      "method": "GET",
      "path": "/api/projects/dashboard",
      "expectedStatus": [200]
    },
    {
      "name": "missing-project",
      "method": "GET",
      "path": "/api/projects/missing-project",
      "expectedStatus": [404]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/1/response/body/project_id",
    "/steps/1/response/body/created_at",
    "/steps/1/response/body/updated_at",
    "/steps/2/request/body/project_id",
    "/steps/2/response/body/project_id",
    "/steps/2/response/body/root_frame_id",
    "/steps/3/response/body/projects",
    "/steps/3/response/body/total",
    "/steps/4/request/path",
    "/steps/4/response/body/project_id",
    "/steps/4/response/body/created_at",
    "/steps/4/response/body/updated_at",
    "/steps/5/response/body/projects",
    "/steps/5/response/body/total_projects",
    "/steps/5/response/body/total_recently_completed"
  ],
  "redactions": []
}
