{
  "schema": "synon.verification-scope.v1",
  "groups": [
    {
      "name": "source-hygiene",
      "paths": [
        "scripts/audit/audit-source-clean.sh",
        "scripts/audit/audit-source-clean-test.sh",
        "scripts/quality/repository_governance.py",
        "scripts/quality/test_repository_governance.py",
        "docs/governance/repository-maintenance.md",
        ".github/ISSUE_TEMPLATE/bug_report.yml",
        ".github/ISSUE_TEMPLATE/feature_request.yml",
        ".github/ISSUE_TEMPLATE/config.yml"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.quality.test_repository_governance"],
        ["python3", "-B", "scripts/quality/repository_governance.py"],
        ["bash", "scripts/audit/audit-source-clean-test.sh"],
        ["bash", "scripts/audit/audit-source-clean.sh"]
      ]
    },
    {
      "name": "release-package",
      "paths": [
        ".github/workflows/packages.yml",
        "scripts/packaging/release_package.py",
        "scripts/packaging/oci_bundle.py",
        "scripts/packaging/test_release_package.py"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.packaging.test_release_package"]
      ]
    },
    {
      "name": "version-proposal",
      "paths": [
        ".github/workflows/version-pr.yml",
        ".github/release-please-config.json",
        ".github/release-please-manifest.json",
        "scripts/packaging/test_version_config.py",
        "scripts/packaging/version_provenance.py",
        "scripts/packaging/sync_version_proposal.py",
        "scripts/packaging/test_version_provenance.py"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.packaging.test_version_config", "scripts.packaging.test_version_provenance"]
      ]
    },
    {
      "name": "frontend-provenance",
      "paths": [
        "scripts/audit/audit_frontend_migration.py",
        "scripts/audit/audit_frontend_migration_test.py",
        "scripts/audit/audit-frontend-migration-test.py"
      ],
      "frontend": true,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.audit.audit_frontend_migration_test"],
        ["python3", "-B", "scripts/audit/audit-frontend-migration-test.py"]
      ]
    },
    {
      "name": "verification-selection",
      "paths": [
        "scripts/quality/README.md",
        "scripts/quality/verification_scope.json",
        "scripts/quality/verification_scope.py",
        "scripts/quality/test_verification_scope.py",
        "scripts/quality/pr_fast_scope.py",
        "scripts/quality/test_pr_fast_scope.py",
        "scripts/quality/pr_dependency_scope.py",
        "scripts/quality/test_pr_dependency_scope.py",
        "scripts/quality/pr_test_partition.py",
        "scripts/quality/test_pr_test_partition.py",
        "scripts/quality/runtime_input_scope.py",
        "scripts/quality/runtime_input_scope.json",
        "scripts/quality/test_runtime_input_scope.py"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.quality.test_pr_fast_scope", "scripts.quality.test_pr_dependency_scope", "scripts.quality.test_pr_test_partition", "scripts.quality.test_verification_scope", "scripts.quality.test_runtime_input_scope"]
      ]
    },
    {
      "name": "schema-and-package-contracts",
      "paths": [
        "docs/governance/product-identity.json",
        "docs/governance/product-identity-consumer-matrix.json",
        "scripts/quality/test_product_identity_gate.py",
        "scripts/package-release-test.sh"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.quality.test_product_identity_gate"],
        ["bash", "-n", "scripts/package-release-test.sh"]
      ]
    },
    {
      "name": "kernel-worker-protocol",
      "paths": [
        "scripts/quality/test_kernel_worker_streams.py",
        "scripts/quality/test_kernel_worker_protocol.py",
        "scripts/quality/kernel_manifest.py",
        "scripts/quality/test_kernel_manifest.py"
      ],
      "frontend": false,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.quality.test_kernel_worker_streams", "scripts.quality.test_kernel_worker_protocol"],
        ["python3", "-B", "scripts/quality/test_kernel_manifest.py"],
        ["python3", "-B", "scripts/quality/kernel_manifest.py"]
      ]
    },
    {
      "name": "workflow-contracts",
      "paths": [
        ".github/workflows/quality-pr.yml",
        ".github/workflows/quality-main.yml",
        ".github/workflows/quality.yml",
        "docs/governance/github-actions-pins.json",
        "scripts/ci-contract-test.sh"
      ],
      "frontend": false,
      "checks": [["bash", "scripts/ci-contract-test.sh"]]
    }
  ]
}
