{
  "schemaVersion": 1,
  "id": "queued-message-delivery",
  "contracts": [
    {"kind": "service", "name": "submitRequest"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "create-project",
      "method": "POST",
      "path": "/api/projects",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"name": "Queued Delivery Oracle", "find_or_create": true},
      "expectedStatus": [200, 201],
      "capture": {"projectId": "/project_id"}
    },
    {
      "name": "create-empty-frame",
      "method": "POST",
      "path": "/api/frames",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"project_id": "${capture:projectId}"},
      "expectedStatus": [201],
      "capture": {"frameId": "/root_frame_id"}
    },
    {
      "name": "submit-active-request",
      "method": "POST",
      "path": "/api/request",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {
        "target_agent": "ONBOARDING",
        "project_id": "${capture:projectId}",
        "root_frame_id": "${capture:frameId}",
        "input_data": {"request": "Complete the active turn before consuming the queue."},
        "intent_id": "00000000-0000-4000-8000-000000000041"
      },
      "expectedStatus": [200]
    },
    {
      "name": "queue-follow-up",
      "method": "POST",
      "path": "/api/request",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {
        "target_agent": "ONBOARDING",
        "project_id": "${capture:projectId}",
        "root_frame_id": "${capture:frameId}",
        "input_data": {"request": "Deliver this follow-up exactly once."},
        "intent_id": "00000000-0000-4000-8000-000000000042"
      },
      "expectedStatus": [200]
    },
    {
      "name": "wait-for-follow-up-delivery",
      "method": "POST",
      "path": "/api/request",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {
        "target_agent": "ONBOARDING",
        "project_id": "${capture:projectId}",
        "root_frame_id": "${capture:frameId}",
        "input_data": {"request": "Deliver this follow-up exactly once."},
        "intent_id": "00000000-0000-4000-8000-000000000042"
      },
      "expectedStatus": [200],
      "poll": {
        "pointer": "/status",
        "equals": "already_delivered",
        "intervalMilliseconds": 100,
        "timeoutMilliseconds": 20000
      }
    },
    {
      "name": "reject-late-retraction",
      "method": "DELETE",
      "path": "/api/frames/${capture:frameId}/queued-messages/00000000-0000-4000-8000-000000000042",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "expectedStatus": [409]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/1/response/body/project_id",
    "/steps/1/response/body/created_at",
    "/steps/1/response/body/updated_at",
    "/steps/2/request/body/project_id",
    "/steps/2/response/body/project_id",
    "/steps/2/response/body/root_frame_id",
    "/steps/3/request/body/project_id",
    "/steps/3/request/body/root_frame_id",
    "/steps/3/response/body/root_frame_id",
    "/steps/3/response/body/frame_id",
    "/steps/4/request/body/project_id",
    "/steps/4/request/body/root_frame_id",
    "/steps/4/response/body/root_frame_id",
    "/steps/4/response/body/frame_id",
    "/steps/5/request/body/project_id",
    "/steps/5/request/body/root_frame_id",
    "/steps/5/response/body/root_frame_id",
    "/steps/5/response/body/frame_id",
    "/steps/6/request/path",
    "/steps/6/response/body/detail"
  ],
  "redactions": []
}
