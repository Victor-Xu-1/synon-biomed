{
  "schema": "synon.verification-scope.v1",
  "groups": [
    {
      "name": "frontend-provenance",
      "paths": [
        "scripts/audit/audit_frontend_migration.py",
        "scripts/audit/audit_frontend_migration_test.py",
        "scripts/audit/audit-frontend-migration-test.py"
      ],
      "frontend": true,
      "checks": [
        ["python3", "-B", "-m", "unittest", "scripts.audit.audit_frontend_migration_test"],
        ["python3", "-B", "scripts/audit/audit-frontend-migration-test.py"]
      ]
    },
    {
