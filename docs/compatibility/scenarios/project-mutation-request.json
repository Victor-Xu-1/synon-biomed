{
  "schemaVersion": 1,
  "id": "project-mutation-request",
  "contracts": [
    {"kind": "service", "name": "updateProject"},
    {"kind": "service", "name": "deleteProject"},
    {"kind": "service", "name": "submitProjectRequest"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "create-project",
      "method": "POST",
      "path": "/api/projects",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {
        "name": "Project Mutation Oracle",
        "description": "before update",
        "context": "before context",
        "find_or_create": true
      },
      "expectedStatus": [200, 201],
      "capture": {"projectId": "/project_id"}
    },
    {
      "name": "update-project",
      "method": "PATCH",
      "path": "/api/projects/${capture:projectId}",
      "headers": {
        "Origin": "${origin}",
        "X-Operon-CSRF": "${cookie:operon_csrf}",
        "Content-Type": "application/json"
      },
      "body": {
        "name": "Project Mutation Updated",
        "description": null,
        "context": "updated context"
      },
      "expectedStatus": [200]
    },
    {
      "name": "submit-project-request",
      "method": "POST",
      "path": "/api/projects/${capture:projectId}/request",
      "headers": {
        "Origin": "${origin}",
        "X-Operon-CSRF": "${cookie:operon_csrf}",
        "Content-Type": "application/json"
      },
      "body": {
        "input_data": {
          "request": "Record the project-scoped request without external tools.",
          "source": "project mutation differential fixture"
        },
        "target_agent": "OPERON",
        "plan_mode": false,
        "intent_id": "00000000-0000-4000-8000-000000000091"
      },
      "expectedStatus": [200]
    },
    {
      "name": "delete-project",
      "method": "DELETE",
      "path": "/api/projects/${capture:projectId}",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "expectedStatus": [200]
    },
    {
      "name": "deleted-project-is-missing",
      "method": "GET",
      "path": "/api/projects/${capture:projectId}",
      "expectedStatus": [404]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/1/response/body/project_id",
    "/steps/1/response/body/created_at",
    "/steps/1/response/body/updated_at",
    "/steps/2/request/path",
    "/steps/2/response/body/project_id",
    "/steps/2/response/body/created_at",
    "/steps/2/response/body/updated_at",
    "/steps/3/request/path",
    "/steps/3/response/body/root_frame_id",
    "/steps/3/response/body/frame_id",
    "/steps/4/request/path",
    "/steps/4/response/body/project_id",
    "/steps/5/request/path",
    "/steps/5/response/body/detail"
  ],
  "redactions": []
}
