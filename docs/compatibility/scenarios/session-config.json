{
  "schemaVersion": 1,
  "id": "session-config",
  "contracts": [
    {"kind": "service", "name": "updateSessionConfig"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "create-project",
      "method": "POST",
      "path": "/api/projects",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"name": "Session Config Oracle", "find_or_create": true},
      "expectedStatus": [200, 201],
      "capture": {"projectId": "/project_id"}
    },
    {
      "name": "create-frame",
      "method": "POST",
      "path": "/api/frames",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"project_id": "${capture:projectId}"},
      "expectedStatus": [201],
      "capture": {"frameId": "/root_frame_id"}
    },
    {
      "name": "set-session-config",
      "method": "POST",
      "path": "/api/frames/${capture:frameId}/session-config",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {
        "verifier_mode": "on",
        "memory_mode": "off",
        "auto_mode": "on",
        "reviewer_model": null,
        "rc_context_ceiling": 200000,
        "python_version": "3.11",
        "kernel_idle_timeout": 60,
        "goal_text": null
      },
      "expectedStatus": [200]
    },
    {
      "name": "patch-nullable-session-config",
      "method": "POST",
      "path": "/api/frames/${capture:frameId}/session-config",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {
        "reviewer_model": "reviewer-model",
        "rc_context_ceiling": null,
        "python_version": null,
        "kernel_idle_timeout": null
      },
      "expectedStatus": [200]
    },
    {
      "name": "reject-gpu-change",
      "method": "POST",
      "path": "/api/frames/${capture:frameId}/session-config",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"gpu_mode": "on"},
      "expectedStatus": [400]
    },
    {
      "name": "reject-empty-change",
      "method": "POST",
      "path": "/api/frames/${capture:frameId}/session-config",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {},
      "expectedStatus": [400]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/1/response/body/project_id",
    "/steps/1/response/body/created_at",
    "/steps/1/response/body/updated_at",
    "/steps/2/request/body/project_id",
    "/steps/2/response/body/project_id",
    "/steps/2/response/body/root_frame_id",
    "/steps/3/request/path",
    "/steps/3/response/body/root_frame_id",
    "/steps/4/request/path",
    "/steps/4/response/body/root_frame_id",
    "/steps/5/request/path",
    "/steps/6/request/path"
  ],
  "redactions": []
}
