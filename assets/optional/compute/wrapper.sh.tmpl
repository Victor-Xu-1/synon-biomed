#!/usr/bin/env bash
set -uo pipefail
cd "$(dirname "$0")"
rm -rf out stdout.log stderr.log .phase .deadline_fired .deadline_termed .job_timeout_fired out.tar.gz out.tar.gz.tmp
mkdir out

# Deadline plumbing (env from _op_submit's launch line; defaults keep an
# old host's submit behaving like today — no watchdog without a deadline,
# and the no-env job-guard fallback is the 72h ceiling so the OLD host's
# outer timeout(1) stays the SOLE deadline in the old-host+new-wrapper
# arm (a 4h fallback here silently failed any legal >4h job).
# OPW_JOB_TIMEOUT is the per-job runaway guard. The container wall is
# anchored on the SANDBOX clock from the host-sent RELATIVE remaining
# seconds — comparing a host-clock epoch against ${EPOCHSECONDS} here
# would shrink the staging margin by any clock skew (host ahead by
# ≥margin ⇒ watchdog never fires). The epoch var is only a fallback for
# a host one release behind. The watchdog TERMs the workload at
# DEADLINE − MARGIN so tar→.phase staging always has MARGIN to run.
# Read BEFORE sourcing .job_env AND made readonly under collision-proof
# names: agent-supplied job env must not be able to override the
# deadline-control plane — neither via OPERON_* keys (host-denied at
# staging) nor by reassigning the wrapper's own variables from inside the
# sourced file (a bare `DEADLINE=0` line would otherwise disarm the
# watchdog). readonly makes any such reassignment a no-op error.
OPW_JOB_TIMEOUT=${OPERON_JOB_TIMEOUT_S:-259200}
OPW_MARGIN=${OPERON_HARVEST_MARGIN_S:-600}
OPW_GRACE=${OPERON_TERM_GRACE_S:-60}
OPW_REMAINING=${OPERON_SANDBOX_REMAINING_S:-0}
OPW_EPOCH=${OPERON_SANDBOX_DEADLINE_EPOCH:-0}
if [ "$OPW_REMAINING" -gt 0 ] 2>/dev/null; then
  OPW_DEADLINE=$(( ${EPOCHSECONDS:-$(date +%s)} + OPW_REMAINING ))
  # Cross-check: the relative value was snapshotted host-side BEFORE the
  # staging upload, so re-anchoring it here (post-untar) lands LATE by the
  # real staging duration. The host pre-subtracts its staging estimate,
  # but a gross under-estimate (slow uplink) could still push past the
  # provider wall — when the epoch is ALSO present and EARLIER, take it.
  # min() is conservative both ways: a skewed-early epoch just fires the
  # watchdog early (staging gets extra margin); a skewed-late epoch is
  # ignored because the relative-derived value wins the min.
  if [ "$OPW_EPOCH" -gt 0 ] 2>/dev/null && [ "$OPW_EPOCH" -lt "$OPW_DEADLINE" ]; then
    OPW_DEADLINE=$OPW_EPOCH
  fi
else
  OPW_DEADLINE=$OPW_EPOCH
fi
readonly OPW_JOB_TIMEOUT OPW_DEADLINE OPW_MARGIN OPW_GRACE
set -a; source .job_env 2>/dev/null || true; set +a
# Back-compat: an OLD host still wraps this script in an outer timeout(1)
# whose group-TERM reaches the wrapper but NOT the workload (own session
# now). Forward it so the job still dies at the old host's deadline; the
# wrapper itself survives to stage.
wpid=
trap '[ -n "$wpid" ] && kill -TERM -- -"$wpid" 2>/dev/null' TERM

t0=${EPOCHSECONDS:-$(date +%s)}
# The workload runs in its OWN session (setsid): kill scope for both the job
# timeout and the watchdog is that group only — this wrapper is never in the
# blast radius, so staging runs no matter how the job ends. --foreground
# keeps timeout, run.sh, and every backgrounded descendant in the ONE group
# whose id we know a priori ($wpid), so the watchdog's group-TERM reaches
# the workload directly and the post-exit reap below can group-KILL
# stragglers without scanning /proc. rc 124 = job timeout fired (TERM to
# run.sh, KILL after $GRACE → 137); a received TERM exits 143.
setsid timeout --foreground --kill-after="$OPW_GRACE" "$OPW_JOB_TIMEOUT" bash run.sh \
  > stdout.log 2> stderr.log &
wpid=$!

wd_pid=
if [ "$OPW_DEADLINE" -gt 0 ] 2>/dev/null; then
  # Double-TERM race fix: cancellation is a FLAG-TRAP, never subshell death
  # — a trapped handler runs between commands, so the record-and-deliver
  # section below always completes once entered. The handler also kills the
  # in-flight sleep ($!) so a cancel landing in an inter-command window
  # can't leave the next `wait` parked for a full tick (bughunter r1 🔴).
  # Sleeps are `sleep & wait $!` because bash defers traps across
  # FOREGROUND children.
  (
    wd_cancelled=
    # Prime $! with an own (instantly reaped) child: the inherited $! is
    # $wpid — the handler's kill would otherwise TERM the workload's direct
    # child if the cancel arrived before the first tick.
    sleep 0 & wait $!
    trap 'wd_cancelled=1; kill $! 2>/dev/null' TERM
    while [ -z "$wd_cancelled" ]; do
      now=${EPOCHSECONDS:-$(date +%s)}
      left=$(( OPW_DEADLINE - OPW_MARGIN - now ))
      [ "$left" -le 0 ] && break
      sleep $(( left < 30 ? left : 30 )) &
      # Covers a cancel that landed before the fork above (the handler then
      # killed an already-reaped pid); paired with the handler's kill this
      # closes every window — wait below can only park on a live tick.
      [ -n "$wd_cancelled" ] && { kill $! 2>/dev/null; break; }
      wait $!
    done
    # Cancelled pre-fire: exit with ZERO deadline state (a lone sentinel
    # would misclassify a clean exit as timed_out).
    [ -n "$wd_cancelled" ] && exit 0
    # Record-and-deliver critical section — no park points. Ordering is
    # load-bearing: sentinel first (host classifies 143/137 as timed_out),
    # marker AFTER the kill (never-TERM immunity — death pre-kill leaves no
    # marker, so the post-exit arm still delivers the one TERM; marker
    # absence now implies external SIGKILL, out of the cancel contract).
    # Marker is workload-forgeable but forging only suppresses the TERM the
    # forger's own group would receive.
    : > .deadline_fired
    kill -TERM -- -"$wpid" 2>/dev/null
    : > .deadline_termed
    # Grace: 1s liveness+cancel-gated ticks (tightens review r10).
    # Ownership: cancelled ⇒ the parent's post-exit arm owns grace+KILL;
    # uncancelled ⇒ this subshell owns it — hence the flag gate on the
    # final KILL too (a cancel in the last tick must not double-own).
    wd_i=0
    while [ "$wd_i" -lt "$OPW_GRACE" ]; do
      [ -n "$wd_cancelled" ] && exit 0
      kill -0 -- -"$wpid" 2>/dev/null || exit 0
      sleep 1 &
      [ -n "$wd_cancelled" ] && { kill $! 2>/dev/null; exit 0; }
      wait $!
      wd_i=$(( wd_i + 1 ))
    done
    [ -n "$wd_cancelled" ] && exit 0
    kill -KILL -- -"$wpid" 2>/dev/null
  ) >/dev/null 2>&1 &
  wd_pid=$!
fi

wait "$wpid"
rc=$?
# A trapped TERM interrupts wait (rc>128) while the workload may still be
# alive — wait again for the real status if so.
if [ "$rc" -gt 128 ] && kill -0 "$wpid" 2>/dev/null; then
  wait "$wpid"
  rc=$?
fi
# Cancel-then-JOIN (double-TERM race fix): the join is the happens-after
# barrier — every marker read below is post-mortem w.r.t. the watchdog, so
# the arm can never observe "marker absent" while the watchdog is still
# between its kill -TERM and its marker write.
# BOUNDED, poll-tick form (🔴 3384754543): a SIGSTOPped watchdog
# (same-UID /proc child, cgroup freezer, operator) never exits and never
# runs its trap — and a blocking `wait "$wd_pid"` on a STOPPED child
# parks forever with no signal to interrupt it (non-interactive bash has
# no WUNTRACED), so ANY blocking-wait loop — counter or not — never
# reaches its own escalation. Poll `kill -0` at 0.2s ticks instead
# (interruptible: the tick is `sleep 0.2 & wait $!`), escalate to SIGKILL
# after 2×OPW_GRACE seconds (not kill -CONT — a hostile stopper can
# re-STOP faster than we CONT; KILL acts on stopped processes), and reap
# with a final `wait` once kill -0 goes false — the reap keeps the
# post-mortem barrier exact. The marker-gated re-TERM arm below already
# owns the killed-mid-section case by design.
if [ -n "$wd_pid" ]; then
  kill "$wd_pid" 2>/dev/null
  wd_join=0
  while kill -0 "$wd_pid" 2>/dev/null; do
    # kill -0 is TRUE for a zombie; only a live-and-runnable child needs
    # ticks. state Z (or stat gone) ⇒ reapable now — break to the wait.
    wd_state=
    read -r _ _ wd_state _ < "/proc/$wd_pid/stat" 2>/dev/null || wd_state=
    case "$wd_state" in Z|"") break ;; esac
    if [ "$wd_join" -ge $(( OPW_GRACE * 10 )) ]; then
      kill -KILL "$wd_pid" 2>/dev/null
    fi
    sleep 0.2 & wait $! 2>/dev/null
    wd_join=$(( wd_join + 1 ))
  done
  wait "$wd_pid" 2>/dev/null
fi
job_wall=$(( ${EPOCHSECONDS:-$(date +%s)} - t0 ))
# Post-exit grace for the WHOLE group. Two arms:
#
# Watchdog arm (.deadline_fired): when the untrapped direct child dies
# instantly on the watchdog's group-TERM, wait() returns in milliseconds
# and the cancel-then-join above ends the watchdog at its next flag
# checkpoint MID-GRACE — its pending KILL never ran, and descendants
# (torchrun workers, python children) would get the final group-KILL with
# near-zero grace. Sleep
# the grace here when any group member survives; skip when the group is
# already empty (the watchdog completed its own grace+KILL, or there were
# no survivors) so a TERM-resistant direct child doesn't cost a second
# full grace before staging. Schedule stays inside the margin: TERM at
# wall−600, KILL by ~wall−540, staging in the remaining ~540 s.
#
# Job-timeout arm (rc 124/137 at budget, no sentinel): timeout(1) signals
# only its direct child (bash), so a pipeline/conda/torchrun descendant
# never saw the TERM — deliver TERM→grace before the final reap.
# (--kill-after is kept on timeout itself so a TERM-ignoring DIRECT child
# still bounds the job guard at budget+grace.) The wall gate keeps an
# HONEST early rc-124 — run.sh ending in its own `timeout N cmd` that
# fired — from wasting a pointless TERM + full-grace sleep before
# staging. Same liveness gate as the watchdog arm: a simple run.sh whose
# whole group died to timeout(1)'s own TERM/KILL is the COMMON case, and
# an ungated sleep here appended a full dead grace (60s billable at
# production defaults) to every job-guard timeout (review r10).
if [ -f .deadline_fired ]; then
  if kill -0 -- -"$wpid" 2>/dev/null; then
    # TERM-if-never-TERMed (review r11 + r13): survivors here would sleep
    # out the grace and hit the final group-KILL having never been TERMed
    # if the watchdog died between its sentinel write and its kill -TERM.
    # Since the cancel-then-join above (flag-trap + wait), the parent's own
    # cancel can no longer produce that state — this branch fires only if
    # the watchdog was externally SIGKILLed mid-section (out of contract,
    # kept as belt-and-suspenders). The .deadline_termed marker gates the
    # repeat: on the common path the watchdog already delivered the one
    # TERM, and a second SIGTERM force-exits graceful second-signal
    # handlers (uvicorn/pytest/Ray convention) mid-checkpoint. The join
    # makes this read post-mortem — the marker state is FINAL here.
    if [ ! -f .deadline_termed ]; then
      kill -TERM -- -"$wpid" 2>/dev/null
    fi
    sleep "$OPW_GRACE"
  fi
elif { [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; } \
  && [ "$job_wall" -ge $(( OPW_JOB_TIMEOUT - 1 )) ]; then
  if kill -0 -- -"$wpid" 2>/dev/null; then
    kill -TERM -- -"$wpid" 2>/dev/null
    sleep "$OPW_GRACE"
  fi
fi
# Reap the workload GROUP before the sentinel scrub below: a backgrounded
# child surviving run.sh could otherwise re-forge the sentinel files after
# the scrub, in the window before the probe reads them live (the probe
# reads them live each round). Thanks to --foreground the whole workload
# shares group $wpid; KILL of an already-dead group is a no-op. Residual:
# a child that setsid()s itself leaves the group and cannot be reaped from
# here — the probe-side staleness gate (sentinel not-newer-than .phase) is
# the second layer for that.
kill -KILL -- -"$wpid" 2>/dev/null
# Record that the job timeout genuinely elapsed so the host can classify
# timed_out rather than failed: rc 137 = timeout(1) escalated to KILL on a
# TERM-resistant workload; rc 124 = timeout(1) fired — but ONLY at budget,
# because an honest run.sh ending in its own `timeout N cmd` propagates
# 124 out with wall ≪ budget and must classify failed, not timed_out
# (review r7: empirically reproduced; the old "only our timeout(1) can
# produce 124" rationale was wrong). The elapsed-time check also keeps an
# external OOM kill (137 BEFORE the budget) out of timed_out. Grammar
# stays done:$rc — sentinel only.
#
# Sentinel authority: both sentinels live in workload-writable /work, so a
# workload could forge them (fake timed_out, taint a clean rc-0 success
# with the partial-outputs hint, or force post-harvest termination of its
# own warm sandbox). Re-derive from wrapper-held facts before staging:
# .job_timeout_fired exists iff rc==137 AND the measured wall reached the
# budget; .deadline_fired survives only if the watchdog window was
# actually reached (small tolerance for clock granularity).
# 1s tolerance: wall = floor(end) − floor(start) can read a genuine
# budget-length run as budget−1 (same granularity allowance the deadline
# sentinel's window check uses).
if [ "$rc" -eq 0 ] && [ -z "$(ls -A out 2>/dev/null)" ]; then
  echo "synon: WARN out/ is empty — nothing will be harvested back (write results under ./out/)" >> stderr.log
fi

# Authenticity clock sample BEFORE the tar (review r13): the deadline
# sentinel's window check below must compare against the time staging
# STARTED, not ended — sampling after tar would widen the deliberate 1s
# forgery tolerance by the whole tar duration (minutes on a large out/).
now_end=${EPOCHSECONDS:-$(date +%s)}
# Staging is UNCONDITIONAL — the deadline ends the run, never the results.
# Marker grammar is load-bearing: done:$rc:$wall / harvest_failed:$rc:$wall
# EXACTLY (old hosts cancel-and-skip-harvest on unknown markers).
# env -u: GNU tar honors TAR_OPTIONS (--checkpoint-action=exec = arbitrary
# exec in this session) and tar -z's gzip child honors GZIP — both ride in
# from the sourced .job_env. The host deny-list also strips them at
# staging; this is the in-sandbox belt so the list isn't load-bearing
# across host/wrapper version skews (review r12).
if env -u TAR_OPTIONS -u GZIP tar -czf out.tar.gz.tmp out stdout.log stderr.log \
  && mv -f out.tar.gz.tmp out.tar.gz; then
  staged=0
else
  staged=1
fi
# Sentinel derivation/scrub runs AFTER staging (review r12): tar can run
# for minutes on a large ./out/, and the probe's staleness gate only
# rejects sentinels NEWER than .phase — so a scrub-then-tar-then-.phase
# order left the whole tar window open for a setsid-escaped child (which
# the group reap above cannot reach) to forge a sentinel that would pass
# the gate. Deriving immediately before the .phase write shrinks the
# forgeable window from minutes to the two adjacent statements below;
# anything written after .phase reads as newer and is ignored by the
# probe. The inputs are wrapper-held facts (rc, measured wall, deadline
# window), so deriving late changes nothing on the honest path.
if { [ "$rc" -eq 137 ] || [ "$rc" -eq 124 ]; } \
  && [ "$job_wall" -ge $(( OPW_JOB_TIMEOUT - 1 )) ]; then
  : > .job_timeout_fired
else
  rm -f .job_timeout_fired
fi
if [ -f .deadline_fired ]; then
  # 1s tolerance only (both clocks are the same EPOCHSECONDS source; the
  # watchdog writes at >= DEADLINE−MARGIN, so a wider window would just
  # hand a forger that many extra pre-watchdog seconds).
  if [ "$OPW_DEADLINE" -le 0 ] 2>/dev/null \
    || [ "$now_end" -lt $(( OPW_DEADLINE - OPW_MARGIN - 1 )) ]; then
    rm -f .deadline_fired
  fi
fi
if [ "$staged" -eq 0 ]; then
  echo "done:$rc:$job_wall" > .phase
else
  echo "harvest_failed:$rc:$job_wall" > .phase
fi
exit $rc
