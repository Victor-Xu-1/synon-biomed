{
  "schemaVersion": 1,
  "id": "mcp-directory-lifecycle",
  "contracts": [
    {"kind": "service", "name": "listMCPConnectors"},
    {"kind": "service", "name": "getDirectoryHealth"},
    {"kind": "service", "name": "reconcileMCPConnectors"},
    {"kind": "service", "name": "addDirectoryConnector"},
    {"kind": "service", "name": "authorizeMCPConnector"}
  ],
  "steps": [
    {"name": "csrf", "method": "GET", "path": "/api/csrf", "headers": {"Origin": "${origin}"}, "expectedStatus": [204]},
    {"name": "list-connectors", "method": "GET", "path": "/api/mcp-servers/connectors", "headers": {"X-Synon-User-Id": "local"}, "expectedStatus": [200]},
    {"name": "directory-health", "method": "GET", "path": "/api/mcp-servers/directory-health", "headers": {"X-Synon-User-Id": "local"}, "expectedStatus": [200]},
    {"name": "reconcile-empty", "method": "POST", "path": "/api/mcp-servers/reconcile", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "expectedStatus": [200]},
    {"name": "add-invalid-directory", "method": "POST", "path": "/api/mcp-servers/directory", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "body": {}, "expectedStatus": [400]},
    {"name": "authorize-missing", "method": "POST", "path": "/api/mcp-servers/connectors/directory:missing/authorize", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "expectedStatus": [400]}
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime"
  ],
  "redactions": []
}
