          "scoreKinds": ["affinity-kcal-mol"],
          "requiredArtifacts": ["ranked-pose", "docking-complex", "execution-log"],
          "requiresWeights": false,
          "executionPack": {
            "id": "molecular-docking.autodock-vina",
