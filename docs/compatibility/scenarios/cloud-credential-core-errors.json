{
  "schemaVersion": 1,
  "id": "cloud-credential-core-errors",
  "contracts": [
    {"kind": "service", "name": "listCloudCredentials"},
    {"kind": "service", "name": "getCloudCredential"},
    {"kind": "service", "name": "deleteCloudCredential"},
    {"kind": "service", "name": "testCloudCredential"},
    {"kind": "service", "name": "listCloudBuckets"},
    {"kind": "service", "name": "listCloudObjects"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "list-empty",
      "method": "GET",
      "path": "/api/cloud-credentials",
      "expectedStatus": [200]
    },
    {
      "name": "get-missing",
      "method": "GET",
      "path": "/api/cloud-credentials/missing-credential",
      "expectedStatus": [404]
    },
    {
      "name": "delete-missing",
      "method": "DELETE",
      "path": "/api/cloud-credentials/missing-credential",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "expectedStatus": [404]
    },
    {
      "name": "test-missing",
      "method": "POST",
      "path": "/api/cloud-credentials/missing-credential/test",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {},
      "expectedStatus": [404]
    },
    {
      "name": "list-buckets-missing",
      "method": "GET",
      "path": "/api/cloud-credentials/missing-credential/buckets",
      "expectedStatus": [404]
    },
    {
      "name": "list-objects-missing",
      "method": "GET",
      "path": "/api/cloud-credentials/missing-credential/objects?bucket=example",
      "expectedStatus": [404]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": ["/runtime"],
  "redactions": []
}
