{
  "schemaVersion": 1,
  "id": "artifact-lineage-execution-log",
  "contracts": [
    {"kind": "service", "name": "getArtifactLineage"},
    {"kind": "service", "name": "getVersionLineage"},
    {"kind": "service", "name": "getExecutionLog"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "reject-missing-artifact-lineage",
      "method": "GET",
      "path": "/api/artifacts/missing-artifact/lineage?slim=1",
      "expectedStatus": [404]
    },
    {
      "name": "reject-missing-version-lineage",
      "method": "GET",
      "path": "/api/artifacts/versions/missing-version/lineage?slim=1",
      "expectedStatus": [404]
    },
    {
      "name": "reject-missing-frame-execution-log",
      "method": "GET",
      "path": "/api/frames/missing-frame/execution-log",
      "expectedStatus": [404]
    },
    {
      "name": "create-project",
      "method": "POST",
      "path": "/api/projects",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"name": "Execution Log Oracle", "find_or_create": true},
      "expectedStatus": [200],
      "capture": {"project_id": "/project_id"}
    },
    {
      "name": "create-frame",
      "method": "POST",
      "path": "/api/frames",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"project_id": "${capture:project_id}"},
      "expectedStatus": [201],
      "capture": {"frame_id": "/root_frame_id"}
    },
    {
      "name": "empty-execution-log-is-array",
      "method": "GET",
      "path": "/api/frames/${capture:frame_id}/execution-log",
      "expectedStatus": [200]
    },
    {
      "name": "missing-version-execution-log-is-array",
      "method": "GET",
      "path": "/api/frames/${capture:frame_id}/execution-log?versionId=missing-version",
      "expectedStatus": [200]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/4/response/body/project_id",
    "/steps/4/response/body/created_at",
    "/steps/4/response/body/updated_at",
    "/steps/5/request/body/project_id",
    "/steps/5/response/body/project_id",
    "/steps/5/response/body/root_frame_id",
    "/steps/6/request/path",
    "/steps/7/request/path"
  ],
  "redactions": []
}
