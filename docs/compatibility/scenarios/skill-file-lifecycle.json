{
  "schemaVersion": 1,
  "id": "skill-file-lifecycle",
  "contracts": [
    {"kind": "service", "name": "listCatalogSkillFiles"},
    {"kind": "service", "name": "downloadSkill"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "list-files",
      "method": "GET",
      "path": "/api/skills/catalog/patent-search/files",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [200]
    },
    {
      "name": "download",
      "method": "GET",
      "path": "/api/skills/catalog/patent-search/download",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [200]
    },
    {
      "name": "reject-packaged-edit",
      "method": "POST",
      "path": "/api/skills/patent-search/edit",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {
        "path": "SKILL.md",
        "old_string": "# Patent Search",
        "new_string": "# Modified Patent Search"
      },
      "expectedStatus": [400, 403]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/2/response/body",
    "/steps/3/response/status",
    "/steps/3/response/body/detail"
  ],
  "redactions": []
}
