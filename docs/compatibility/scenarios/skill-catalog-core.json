{
  "schemaVersion": 1,
  "id": "skill-catalog-core",
  "contracts": [
    {"kind": "service", "name": "listSkillCatalog"},
    {"kind": "service", "name": "setSkillEnabled"},
    {"kind": "service", "name": "getCatalogSkillContent"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "list-catalog",
      "method": "GET",
      "path": "/api/skills/catalog",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [200]
    },
    {
      "name": "disable-skill",
      "method": "PUT",
      "path": "/api/skills/catalog/patent-search/enabled",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"enabled": false},
      "expectedStatus": [200]
    },
    {
      "name": "list-disabled-catalog",
      "method": "GET",
      "path": "/api/skills/catalog",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [200]
    },
    {
      "name": "read-skill-content",
      "method": "GET",
      "path": "/api/skills/catalog/patent-search/content",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [200]
    },
    {
      "name": "reject-content-traversal",
      "method": "GET",
      "path": "/api/skills/catalog/patent-search/content?path=..%2Fsecret.txt",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [200, 400, 404]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/1/response/body/skills",
    "/steps/3/response/body/skills",
    "/steps/5/response/status",
    "/steps/5/response/body"
  ],
  "redactions": []
}
