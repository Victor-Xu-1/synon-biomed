{
  "schemaVersion": 1,
  "id": "secret-list-create-update",
  "contracts": [
    {"kind": "service", "name": "listSecrets"},
    {"kind": "service", "name": "createSecret"},
    {"kind": "service", "name": "updateSecret"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "empty-secret-list",
      "method": "GET",
      "path": "/api/secrets",
      "expectedStatus": [200]
    },
    {
      "name": "reject-invalid-provider",
      "method": "POST",
      "path": "/api/secrets",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"provider": "unsupported", "credentials": {}},
      "expectedStatus": [400]
    },
    {
      "name": "reject-incomplete-generic",
      "method": "POST",
      "path": "/api/secrets",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"provider": "generic"},
      "expectedStatus": [400]
    },
    {
      "name": "create-generic-secret",
      "method": "POST",
      "path": "/api/secrets",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"provider": "generic", "name": "oracle_key", "value": "oracle-secret", "description": "initial"},
      "expectedStatus": [201],
      "capture": {"generic_id": "/id"}
    },
    {
      "name": "list-created-secret",
      "method": "GET",
      "path": "/api/secrets",
      "expectedStatus": [200]
    },
    {
      "name": "update-generic-secret",
      "method": "PATCH",
      "path": "/api/secrets/${capture:generic_id}",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"name": "oracle_key_updated", "value": "updated-secret", "description": "updated"},
      "expectedStatus": [200]
    },
    {
      "name": "clear-description",
      "method": "PATCH",
      "path": "/api/secrets/${capture:generic_id}",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"description": null},
      "expectedStatus": [200]
    },
    {
      "name": "ignore-non-updatable-fields",
      "method": "PATCH",
      "path": "/api/secrets/${capture:generic_id}",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"provider": "github", "credential_type": "ignored"},
      "expectedStatus": [200]
    },
    {
      "name": "reject-missing-secret-update",
      "method": "PATCH",
      "path": "/api/secrets/missing-secret",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"description": "no mutation"},
      "expectedStatus": [404]
    },
    {
      "name": "create-github-secret",
      "method": "POST",
      "path": "/api/secrets",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"provider": "github", "credentials": {"token": "github-oracle-token"}},
      "expectedStatus": [201],
      "capture": {"github_id": "/id"}
    },
    {
      "name": "reject-duplicate-github-secret",
      "method": "POST",
      "path": "/api/secrets",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"provider": "github", "credentials": {"token": "another-github-token"}},
      "expectedStatus": [400]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/4/response/body/id",
    "/steps/4/response/body/created_at",
    "/steps/4/response/body/updated_at",
    "/steps/5/response/body/0/id",
    "/steps/5/response/body/0/created_at",
    "/steps/5/response/body/0/updated_at",
    "/steps/6/request/path",
    "/steps/6/response/body/id",
    "/steps/6/response/body/created_at",
    "/steps/6/response/body/updated_at",
    "/steps/7/request/path",
    "/steps/7/response/body/id",
    "/steps/7/response/body/created_at",
    "/steps/7/response/body/updated_at",
    "/steps/8/request/path",
    "/steps/8/response/body/id",
    "/steps/8/response/body/created_at",
    "/steps/8/response/body/updated_at",
    "/steps/10/response/body/id",
    "/steps/10/response/body/created_at",
    "/steps/10/response/body/updated_at"
  ],
  "redactions": []
}
