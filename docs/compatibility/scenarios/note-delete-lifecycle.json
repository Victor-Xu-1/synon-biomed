{
  "schemaVersion": 1,
  "id": "note-delete-lifecycle",
  "contracts": [
    {"kind": "service", "name": "deleteNote"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "create-project",
      "method": "POST",
      "path": "/api/projects",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"name": "Note Delete Oracle", "find_or_create": true},
      "expectedStatus": [200],
      "capture": {"project_id": "/project_id"}
    },
    {
      "name": "create-frame",
      "method": "POST",
      "path": "/api/frames",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"project_id": "${capture:project_id}"},
      "expectedStatus": [201],
      "capture": {"frame_id": "/root_frame_id"}
    },
    {
      "name": "create-note",
      "method": "POST",
      "path": "/api/projects/${capture:project_id}/notes",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"target_type": "bench", "target_frame_id": "${capture:frame_id}", "content": "Delete this note"},
      "expectedStatus": [200],
      "capture": {"note_id": "/id"}
    },
    {
      "name": "delete-note",
      "method": "DELETE",
      "path": "/api/notes/${capture:note_id}",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "expectedStatus": [200]
    },
    {
      "name": "list-after-delete",
      "method": "GET",
      "path": "/api/projects/${capture:project_id}/notes",
      "expectedStatus": [200]
    },
    {
      "name": "reject-missing-note",
      "method": "DELETE",
      "path": "/api/notes/missing-note",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "expectedStatus": [404]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/1/response/body/project_id",
    "/steps/1/response/body/created_at",
    "/steps/1/response/body/updated_at",
    "/steps/2/request/body/project_id",
    "/steps/2/response/body/project_id",
    "/steps/2/response/body/root_frame_id",
    "/steps/3/request/path",
    "/steps/3/request/body/target_frame_id",
    "/steps/3/response/body/id",
    "/steps/3/response/body/project_id",
    "/steps/3/response/body/target_frame_id",
    "/steps/3/response/body/created_at",
    "/steps/3/response/body/updated_at",
    "/steps/3/response/body/user_id",
    "/steps/4/request/path",
    "/steps/4/response/body/note_id",
    "/steps/5/request/path"
  ],
  "redactions": []
}
