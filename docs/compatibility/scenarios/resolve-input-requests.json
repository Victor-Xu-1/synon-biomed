{
  "schemaVersion": 1,
  "id": "resolve-input-requests",
  "contracts": [
    {"kind": "service", "name": "resolveInputRequests"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "create-project",
      "method": "POST",
      "path": "/api/projects",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"name": "Resolve Input Oracle", "find_or_create": true},
      "expectedStatus": [200, 201],
      "capture": {"projectId": "/project_id"}
    },
    {
      "name": "create-frame",
      "method": "POST",
      "path": "/api/frames",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"project_id": "${capture:projectId}"},
      "expectedStatus": [201],
      "capture": {"frameId": "/root_frame_id"}
    },
    {
      "name": "empty-responses",
      "method": "POST",
      "path": "/api/frames/${capture:frameId}/resolve-input",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"responses": []},
      "expectedStatus": [400]
    },
    {
      "name": "unknown-request",
      "method": "POST",
      "path": "/api/frames/${capture:frameId}/resolve-input",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"responses": [{"tool_id": "unknown", "action": "answer", "answers": {"Question?": "Answer"}}]},
      "expectedStatus": [400]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/1/response/body/project_id",
    "/steps/1/response/body/created_at",
    "/steps/1/response/body/updated_at",
    "/steps/2/request/body/project_id",
    "/steps/2/response/body/project_id",
    "/steps/2/response/body/root_frame_id",
    "/steps/3/request/path",
    "/steps/4/request/path",
    "/steps/4/response/body/detail"
  ],
  "redactions": []
}
