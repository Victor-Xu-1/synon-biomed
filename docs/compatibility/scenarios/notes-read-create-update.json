{
  "schemaVersion": 1,
  "id": "notes-read-create-update",
  "contracts": [
    {"kind": "service", "name": "getNotes"},
    {"kind": "service", "name": "createNote"},
    {"kind": "service", "name": "updateNote"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "reject-missing-project",
      "method": "GET",
      "path": "/api/projects/missing-project/notes",
      "expectedStatus": [404]
    },
    {
      "name": "create-project",
      "method": "POST",
      "path": "/api/projects",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"name": "Notes Oracle", "find_or_create": true},
      "expectedStatus": [200],
      "capture": {"project_id": "/project_id"}
    },
    {
      "name": "create-frame",
      "method": "POST",
      "path": "/api/frames",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"project_id": "${capture:project_id}"},
      "expectedStatus": [201],
      "capture": {"frame_id": "/root_frame_id"}
    },
    {
      "name": "empty-note-list",
      "method": "GET",
      "path": "/api/projects/${capture:project_id}/notes",
      "expectedStatus": [200]
    },
    {
      "name": "create-bench-note",
      "method": "POST",
      "path": "/api/projects/${capture:project_id}/notes",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"target_type": "bench", "target_frame_id": "${capture:frame_id}", "content": "Oracle note"},
      "expectedStatus": [200],
      "capture": {"note_id": "/id"}
    },
    {
      "name": "filter-note-list",
      "method": "GET",
      "path": "/api/projects/${capture:project_id}/notes?q=oracle&target_type=bench&target_frame_id=${capture:frame_id}",
      "expectedStatus": [200]
    },
    {
      "name": "update-note",
      "method": "PATCH",
      "path": "/api/notes/${capture:note_id}",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"content": "Updated oracle note"},
      "expectedStatus": [200]
    },
    {
      "name": "reject-empty-content",
      "method": "POST",
      "path": "/api/projects/${capture:project_id}/notes",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"target_type": "bench", "target_frame_id": "${capture:frame_id}", "content": "  "},
      "expectedStatus": [400]
    },
    {
      "name": "reject-missing-message-index",
      "method": "POST",
      "path": "/api/projects/${capture:project_id}/notes",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"target_type": "message", "target_frame_id": "${capture:frame_id}", "content": "Index required"},
      "expectedStatus": [400]
    },
    {
      "name": "reject-missing-note",
      "method": "PATCH",
      "path": "/api/notes/missing-note",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"content": "No mutation"},
      "expectedStatus": [404]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/2/response/body/project_id",
    "/steps/2/response/body/created_at",
    "/steps/2/response/body/updated_at",
    "/steps/3/request/body/project_id",
    "/steps/3/response/body/project_id",
    "/steps/3/response/body/root_frame_id",
    "/steps/4/request/path",
    "/steps/5/request/path",
    "/steps/5/request/body/target_frame_id",
    "/steps/5/response/body/id",
    "/steps/5/response/body/project_id",
    "/steps/5/response/body/target_frame_id",
    "/steps/5/response/body/created_at",
    "/steps/5/response/body/updated_at",
	"/steps/5/response/body/user_id",
    "/steps/6/request/path",
    "/steps/6/response/body/0/id",
    "/steps/6/response/body/0/project_id",
    "/steps/6/response/body/0/target_frame_id",
    "/steps/6/response/body/0/created_at",
    "/steps/6/response/body/0/updated_at",
	"/steps/6/response/body/0/user_id",
    "/steps/7/request/path",
    "/steps/7/response/body/id",
    "/steps/7/response/body/project_id",
    "/steps/7/response/body/target_frame_id",
    "/steps/7/response/body/created_at",
    "/steps/7/response/body/updated_at",
	"/steps/7/response/body/user_id",
    "/steps/8/request/path",
    "/steps/8/request/body/target_frame_id",
    "/steps/9/request/path",
    "/steps/9/request/body/target_frame_id"
  ],
  "redactions": []
}
