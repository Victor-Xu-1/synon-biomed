{
  "schemaVersion": 1,
  "id": "frame-streaming-buffers",
  "contracts": [
    {"kind": "service", "name": "getStreamingBuffer"},
    {"kind": "service", "name": "getStreamingBuffers"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "create-project",
      "method": "POST",
      "path": "/api/projects",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {
        "name": "Frame Streaming Oracle",
        "description": "Isolated streaming recovery fixture",
        "find_or_create": true
      },
      "expectedStatus": [200, 201],
      "capture": {"projectId": "/project_id"}
    },
    {
      "name": "create-frame",
      "method": "POST",
      "path": "/api/frames",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"project_id": "${capture:projectId}"},
      "expectedStatus": [201],
      "capture": {"frameId": "/root_frame_id"}
    },
    {
      "name": "get-empty-stream",
      "method": "GET",
      "path": "/api/frames/${capture:frameId}/streaming",
      "expectedStatus": [200]
    },
    {
      "name": "get-root-streams",
      "method": "POST",
      "path": "/api/frames/${capture:frameId}/streaming-batch",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"ids": ["${capture:frameId}"]},
      "expectedStatus": [200]
    },
    {
      "name": "get-missing-stream",
      "method": "GET",
      "path": "/api/frames/00000000-0000-4000-8000-000000000099/streaming",
      "expectedStatus": [404]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/1/response/body/project_id",
    "/steps/1/response/body/created_at",
    "/steps/1/response/body/updated_at",
    "/steps/2/request/body/project_id",
    "/steps/2/response/body/project_id",
    "/steps/2/response/body/root_frame_id",
    "/steps/3/request/path",
    "/steps/4/request/path",
    "/steps/4/request/body/ids/0",
    "/steps/4/response/body/root_frame_id",
    "/steps/5/response/body/detail"
  ],
  "redactions": []
}
