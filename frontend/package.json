  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint packages/desktop/src tests/unit",
    "format:check": "oxfmt --check package.json packages/desktop/src tests/unit",
    "i18n:types": "node scripts/generate-i18n-types.js",
    "test": "vitest run --project node --project dom",
    "test:unit": "vitest run --project node --project dom",
    "test:integration:real": "vitest run --project real-integration",
    "test:packaged": "vitest run --project packaged",
    "test:e2e:web": "playwright test --config playwright.webui.config.ts"
  },
