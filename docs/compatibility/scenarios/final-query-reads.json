{
  "schemaVersion": 1,
  "id": "final-query-reads",
  "contracts": [
    {"kind": "query", "name": "branchMessages"},
    {"kind": "query", "name": "verificationChecks"},
    {"kind": "query", "name": "artifactVerification"},
    {"kind": "query", "name": "tokenSeries"},
    {"kind": "query", "name": "searchArtifactsBatch"},
    {"kind": "query", "name": "searchBenchesBatch"},
    {"kind": "query", "name": "benchNameSearch"},
    {"kind": "query", "name": "benchNameSearchBatch"},
    {"kind": "query", "name": "bench"},
    {"kind": "query", "name": "skillDrafts"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "create-project",
      "method": "POST",
      "path": "/api/projects",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"name": "Final Query Oracle", "find_or_create": true},
      "expectedStatus": [200, 201],
      "capture": {"projectId": "/project_id"}
    },
    {
      "name": "create-root-frame",
      "method": "POST",
      "path": "/api/frames",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"project_id": "${capture:projectId}"},
      "expectedStatus": [201],
      "capture": {"rootFrameId": "/root_frame_id"}
    },
    {
      "name": "send-root-message",
      "method": "POST",
      "path": "/api/frames/${capture:rootFrameId}/message",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"input_data": {"request": "Create branch query evidence."}},
      "expectedStatus": [200],
      "async": true,
      "settleMilliseconds": 2000
    },
    {
      "name": "await-root-message",
      "await": "send-root-message"
    },
    {
      "name": "cancel-root-frame",
      "method": "POST",
      "path": "/api/frames/${capture:rootFrameId}/cancel?reason=final-query-oracle",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "expectedStatus": [200]
    },
    {
      "name": "fork-root-frame",
      "method": "POST",
      "path": "/api/frames/${capture:rootFrameId}/fork",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {
        "message_index": 0,
        "edited_content": "Edited branch query evidence.",
        "source_branch_id": null,
        "verifier_mode": "on",
        "memory_mode": "off",
        "ultra_mode": false,
        "plan_mode": false,
        "target_agent": "ONBOARDING"
      },
      "expectedStatus": [200],
      "capture": {"branchId": "/branch_id"}
    },
    {
      "name": "read-branch-messages",
      "method": "GET",
      "path": "/api/frames/${capture:rootFrameId}/branches/${capture:branchId}/messages",
      "expectedStatus": [200]
    },
    {
      "name": "read-verification",
      "method": "GET",
      "path": "/api/frames/${capture:rootFrameId}/verification",
      "expectedStatus": [200]
    },
    {
      "name": "read-missing-artifact-verification",
      "method": "GET",
      "path": "/api/artifacts/versions/missing-version/verification",
      "expectedStatus": [404]
    },
    {
      "name": "read-frame-token-classes",
      "method": "GET",
      "path": "/api/frames/${capture:rootFrameId}/token-classes",
      "expectedStatus": [200]
    },
    {
      "name": "read-token-class-series",
      "method": "GET",
      "path": "/api/token-classes?window=24h",
      "expectedStatus": [200]
    },
    {
      "name": "search-artifacts-batch",
      "method": "GET",
      "path": "/api/projects/batch/artifacts?pids=${capture:projectId}&limit=2",
      "expectedStatus": [200]
    },
    {
      "name": "search-project-benches",
      "method": "GET",
      "path": "/api/projects/${capture:projectId}/benches?q=Final&limit=2",
      "expectedStatus": [200]
    },
    {
      "name": "search-benches-batch",
      "method": "GET",
      "path": "/api/projects/batch/benches?pids=${capture:projectId}&q=Final&limit=2",
      "expectedStatus": [200]
    },
    {
      "name": "read-bench",
      "method": "GET",
      "path": "/api/frames/${capture:rootFrameId}?shallow=true",
      "expectedStatus": [200]
    },
    {
      "name": "read-skill-drafts",
      "method": "GET",
      "path": "/api/skills/drafts",
      "expectedStatus": [200]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/1/response/body/project_id",
    "/steps/1/response/body/created_at",
    "/steps/1/response/body/updated_at",
    "/steps/2/request/body/project_id",
    "/steps/2/response/body/project_id",
    "/steps/2/response/body/root_frame_id",
    "/steps/3/request/path",
    "/steps/3/response/body/root_frame_id",
    "/steps/3/response/body/frame_id",
    "/steps/4/request/path",
    "/steps/4/response/body/root_frame_id",
    "/steps/4/response/body/cancelled_frames/0",
    "/steps/5/request/path",
    "/steps/5/response/body/root_frame_id",
    "/steps/5/response/body/branch_id",
    "/steps/6/request/path",
    "/steps/6/response/body/frame_id",
    "/steps/6/response/body/branch_id",
    "/steps/6/response/body/messages",
    "/steps/7/request/path",
    "/steps/9/request/path",
    "/steps/9/response/body/root_frame_id",
    "/steps/10/response/body/sessions",
    "/steps/11/request/path",
    "/steps/11/response/body",
    "/steps/12/request/path",
    "/steps/12/response/body",
    "/steps/13/request/path",
    "/steps/13/response/body",
    "/steps/14/request/path",
    "/steps/14/response/body/id",
    "/steps/14/response/body/project_id",
    "/steps/14/response/body/root_frame_id",
    "/steps/14/response/body/created_at",
    "/steps/14/response/body/updated_at",
    "/steps/14/response/body/completed_at",
    "/steps/14/response/body/context_data",
    "/steps/14/response/body/message_count",
    "/steps/14/response/body/output_data",
    "/steps/14/response/body/status",
    "/steps/15/response/body/drafts"
  ],
  "redactions": []
}
