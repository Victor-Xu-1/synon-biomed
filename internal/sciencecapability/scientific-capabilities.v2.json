    {
      "id": "binding-pocket-prediction",
      "description": "Predict and rank ligand-binding pockets on a protein surface with a recorded scientific engine execution.",
      "acceptedEngines": [
        {
          "id": "p2rank",
          "package": "p2rank",
          "requiredInputs": ["protein-structure", "p2rank-release-archive"],
          "scoreKinds": ["pocket-probability", "pocket-score"],
          "requiredArtifacts": ["pocket-candidates", "pocket-selection", "execution-log"],
          "requiresWeights": true,
          "executionPack": {
            "id": "binding-pocket-prediction.p2rank",
            "mode": "local",
            "skill": "p2rank-pocket-detection",
            "provider": "local-conda",
            "language": "python",
            "packages": [
              {"manager": "conda", "spec": "openjdk=17"}
            ],
            "channels": ["conda-forge"],
            "executable": "python",
            "script": "executionpacks/p2rank_binding_pockets.py",
            "cliWitnesses": [
              {"executable": "java", "arguments": ["-version"]}
            ],
            "inputs": [
              {"kind": "protein-structure", "argument": "--structure", "extensions": [".pdb"]},
              {"kind": "p2rank-release-archive", "argument": "--p2rank-archive", "extensions": [".tar.gz", ".tgz"]}
            ],
            "downloads": [
              {
                "inputKind": "p2rank-release-archive",
                "url": "https://github.com/rdk/p2rank/releases/download/2.5.1/p2rank_2.5.1.tar.gz",
                "filename": "p2rank_2.5.1.tar.gz",
                "sha256": "d243f2d9036ac053fefb9407b5fe1c85f4fe077c519fd975ac585e995feab274",
                "sizeBytes": 275625956,
                "redirectHosts": ["release-assets.githubusercontent.com"]
              }
            ],
            "parameters": [
              {"name": "method", "argument": "--method", "type": "string", "required": true, "evidence": "selected-evidence-resolver"},
              {"name": "profile", "argument": "--profile", "type": "string", "required": false, "default": "auto"},
              {"name": "top_k", "argument": "--top-k", "type": "integer", "required": false, "default": 5, "minimum": 1, "maximum": 20},
              {"name": "threads", "argument": "--threads", "type": "integer", "required": false, "default": 4, "minimum": 1, "maximum": 8},
              {"name": "minimum_box_size", "argument": "--minimum-box-size", "type": "number", "required": false, "default": 20, "minimum": 8, "maximum": 100},
              {"name": "box_padding", "argument": "--box-padding", "type": "number", "required": false, "default": 6, "minimum": 0, "maximum": 30}
            ],
            "outputs": [
              {"kind": "pocket-candidates", "path": "pocket_detection/pocket_candidates.csv", "format": "csv", "minBytes": 64, "minRecords": 1},
              {"kind": "pocket-selection", "path": "pocket_detection/pocket_selection.json", "format": "json", "minBytes": 128},
              {"kind": "selected-pocket-atoms", "path": "pocket_detection/selected_pocket_atoms.pdb", "format": "text", "minBytes": 64},
              {"kind": "execution-log", "path": "pocket_detection/p2rank.log", "format": "text", "minBytes": 32},
              {"kind": "validation-record", "path": "pocket_detection/pocket_validation.json", "format": "json", "minBytes": 128, "requiredJsonTrue": ["/overall_pass", "/checks/source_integrity", "/checks/archive_integrity", "/checks/engine_identity", "/checks/rank_integrity", "/checks/probability_integrity", "/checks/box_integrity", "/checks/output_integrity"]}
            ],
            "comparisons": [
              {"path": "pocket_detection/pocket_candidates.csv", "derivedColumns": ["rank"], "basisColumns": ["score", "probability", "center_x", "center_y", "center_z", "size_x", "size_y", "size_z"]}
            ],
            "scoreKind": "pocket-probability"
          }
        }
      ]
    },
    {
      "id": "molecular-docking",
