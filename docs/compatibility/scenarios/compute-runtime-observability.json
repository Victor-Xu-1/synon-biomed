{
  "schemaVersion": 1,
  "id": "compute-runtime-observability",
  "contracts": [
    {"kind": "http-route", "name": "GET /api/compute/managed-endpoints"},
    {"kind": "http-route", "name": "POST /api/compute/managed-endpoints/:name/stop"},
    {"kind": "http-route", "name": "GET /api/compute/jobs"},
    {"kind": "http-route", "name": "GET /api/compute/jobs/:jobId"},
    {"kind": "http-route", "name": "GET /api/compute/jobs/:jobId/logs"},
    {"kind": "http-route", "name": "GET /api/compute/ssh-config-aliases"},
    {"kind": "http-route", "name": "GET /api/compute/local/hostinfo"},
    {"kind": "query", "name": "computeJobs"},
    {"kind": "query", "name": "managedEndpoints"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "managed-endpoints-empty",
      "method": "GET",
      "path": "/api/compute/managed-endpoints",
      "expectedStatus": [200]
    },
    {
      "name": "stop-missing-endpoint",
      "method": "POST",
      "path": "/api/compute/managed-endpoints/oracle-missing/stop",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "expectedStatus": [404]
    },
    {
      "name": "create-project",
      "method": "POST",
      "path": "/api/projects",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {"name": "Compute Runtime Oracle", "find_or_create": true},
      "expectedStatus": [200, 201],
      "capture": {"project": "/project_id"}
    },
    {
      "name": "submit-root-frame",
      "method": "POST",
      "path": "/api/projects/${capture:project}/request",
      "headers": {"Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"},
      "body": {
        "input_data": {"request": "Create an isolated root for compute runtime coverage."},
        "target_agent": "OPERON",
        "intent_id": "00000000-0000-4000-8000-000000000301"
      },
      "expectedStatus": [200]
    },
    {
      "name": "jobs-empty",
      "method": "GET",
      "path": "/api/compute/jobs?projectId=${capture:project}",
      "expectedStatus": [200]
    },
    {
      "name": "job-missing",
      "method": "GET",
      "path": "/api/compute/jobs/oracle-missing-job",
      "expectedStatus": [200, 404]
    },
    {
      "name": "job-log-missing",
      "method": "GET",
      "path": "/api/compute/jobs/oracle-missing-job/logs",
      "expectedStatus": [404]
    },
    {
      "name": "ssh-aliases",
      "method": "GET",
      "path": "/api/compute/ssh-config-aliases",
      "expectedStatus": [200]
    },
    {
      "name": "local-host-info",
      "method": "GET",
      "path": "/api/compute/local/hostinfo",
      "expectedStatus": [200]
    }
  ],
  "maxBodyBytes": 1048576,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
    "/steps/3/response/body/project_id",
    "/steps/3/response/body/created_at",
    "/steps/3/response/body/updated_at",
    "/steps/4/request/path",
    "/steps/4/response/body/frame_id",
    "/steps/4/response/body/root_frame_id",
    "/steps/5/request/path",
    "/steps/8/response/body/configPath"
  ],
  "redactions": []
}
