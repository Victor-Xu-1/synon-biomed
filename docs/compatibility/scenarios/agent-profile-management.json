{
  "schemaVersion": 1,
  "id": "agent-profile-management",
  "contracts": [
    {"kind": "service", "name": "getCustomAgentPrompt"},
    {"kind": "service", "name": "setCustomAgentPrompt"},
    {"kind": "service", "name": "deleteCustomAgentPrompt"},
    {"kind": "service", "name": "createAgent"},
    {"kind": "service", "name": "updateAgent"},
    {"kind": "service", "name": "deleteAgent"},
    {"kind": "service", "name": "setAgentEnabled"},
    {"kind": "service", "name": "attachSkillToAgent"},
    {"kind": "service", "name": "detachSkillFromAgent"},
    {"kind": "service", "name": "updateAgentSkills"}
  ],
  "steps": [
	{"name": "csrf", "method": "GET", "path": "/api/csrf", "headers": {"Origin": "${origin}"}, "expectedStatus": [204]},
    {"name": "get-empty-prompt", "method": "GET", "path": "/api/agents/OPERON/custom-prompt", "headers": {"X-Synon-User-Id": "local"}, "expectedStatus": [200]},
	{"name": "set-prompt", "method": "PUT", "path": "/api/agents/OPERON/custom-prompt", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "body": {"prompt_text": "Always cite primary evidence."}, "expectedStatus": [200]},
    {"name": "get-prompt", "method": "GET", "path": "/api/agents/OPERON/custom-prompt", "headers": {"X-Synon-User-Id": "local"}, "expectedStatus": [200]},
	{"name": "delete-prompt", "method": "DELETE", "path": "/api/agents/OPERON/custom-prompt", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "expectedStatus": [204]},
	{"name": "create-agent", "method": "POST", "path": "/api/agents", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "body": {"name": "profile_oracle", "displayName": "Profile Oracle", "description": "Agent profile contract fixture", "systemPrompt": "Use the profile fixture.", "skillNames": [], "unrestricted": false, "iconKey": "flask", "colorKey": "green", "tags": ["fixture"], "enabled": true}, "expectedStatus": [200]},
	{"name": "update-agent", "method": "PATCH", "path": "/api/agents/PROFILE_ORACLE", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "body": {"displayName": "Updated Oracle", "description": "Updated fixture", "systemPrompt": "Updated prompt."}, "expectedStatus": [200]},
	{"name": "disable-agent", "method": "POST", "path": "/api/agents/PROFILE_ORACLE/enabled", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "body": {"enabled": false}, "expectedStatus": [200]},
	{"name": "attach-skill", "method": "POST", "path": "/api/agents/PROFILE_ORACLE/skills", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "body": {"skill_name": "literature-review"}, "expectedStatus": [200]},
	{"name": "update-skills", "method": "PUT", "path": "/api/agents/PROFILE_ORACLE/skills", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "body": {"attach": ["citation-management", "patent-search"], "detach": ["literature-review"]}, "expectedStatus": [200]},
	{"name": "detach-skill", "method": "DELETE", "path": "/api/agents/PROFILE_ORACLE/skills/patent-search", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "expectedStatus": [200]},
	{"name": "delete-agent", "method": "DELETE", "path": "/api/agents/PROFILE_ORACLE", "headers": {"X-Synon-User-Id": "local", "Origin": "${origin}", "X-Operon-CSRF": "${cookie:operon_csrf}"}, "expectedStatus": [204]}
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": [
    "/runtime",
	"/steps/2/response/body/created_at", "/steps/2/response/body/updated_at",
	"/steps/3/response/body/created_at", "/steps/3/response/body/updated_at",
	"/steps/5/response/body/id", "/steps/6/response/body/id", "/steps/7/response/body/id",
	"/steps/8/response/body/id", "/steps/9/response/body/id", "/steps/10/response/body/id",
	"/steps/5/response/body/parameters/system_prompt", "/steps/6/response/body/parameters/system_prompt",
	"/steps/7/response/body/parameters/system_prompt", "/steps/8/response/body/parameters/system_prompt",
	"/steps/9/response/body/parameters/system_prompt", "/steps/10/response/body/parameters/system_prompt"
  ],
  "redactions": []
}
