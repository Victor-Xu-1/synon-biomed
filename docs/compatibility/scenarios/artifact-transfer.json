{
  "schemaVersion": 1,
  "id": "artifact-transfer",
  "contracts": [
    {"kind": "service", "name": "downloadVersionToFile"},
    {"kind": "service", "name": "getAttachmentBlob"},
    {"kind": "service", "name": "downloadAllArtifacts"},
    {"kind": "service", "name": "downloadSelectedArtifacts"},
    {"kind": "service", "name": "uploadProjectAttachment"}
  ],
  "steps": [
    {
      "name": "csrf",
      "method": "GET",
      "path": "/api/csrf",
      "headers": {"Origin": "${origin}"},
      "expectedStatus": [204]
    },
    {
      "name": "missing-version-save-as-preflight",
      "method": "GET",
      "path": "/api/artifacts/versions/missing-version?filename=saved.txt",
      "headers": {"Range": "bytes=0-0", "X-Synon-User-Id": "local"},
      "expectedStatus": [404]
    },
    {
      "name": "missing-attachment-blob",
      "method": "GET",
      "path": "/api/attachments/missing-attachment",
      "headers": {"X-Synon-User-Id": "local"},
      "expectedStatus": [404]
    },
    {
      "name": "missing-conversation-artifacts",
      "method": "GET",
      "path": "/api/frames/missing-frame/artifacts/download",
      "headers": {"X-Synon-User-Id": "local"},
      "expectedStatus": [404, 500]
    },
    {
      "name": "reject-empty-selection",
      "method": "GET",
      "path": "/api/artifacts/download",
      "headers": {"X-Synon-User-Id": "local"},
      "expectedStatus": [400]
    },
    {
      "name": "reject-upload-without-file",
      "method": "POST",
      "path": "/api/projects/missing-project/attachments",
      "headers": {
        "Origin": "${origin}",
        "X-Operon-CSRF": "${cookie:operon_csrf}",
        "X-Synon-User-Id": "local"
      },
      "expectedStatus": [400, 406]
    }
  ],
  "maxBodyBytes": 4194304,
  "comparisonMode": "candidate-superset",
  "normalization": ["/runtime", "/steps/3/response"],
  "redactions": []
}
