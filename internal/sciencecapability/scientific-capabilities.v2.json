            "language": "python",
            "packages": [
              {"manager": "conda", "spec": "vina=1.2.7"},
              {"manager": "conda", "spec": "meeko=0.8.0"},
              {"manager": "conda", "spec": "rdkit=2026.03.1"},
              {"manager": "conda", "spec": "gemmi=0.7.5"},
              {"manager": "conda", "spec": "prody=2.6.1"},
              {"manager": "conda", "spec": "biopython=1.88"},
              {"manager": "conda", "spec": "openbabel=3.2.1"}
            ],
            "channels": ["conda-forge"],
            "imports": ["vina", "meeko", "rdkit", "gemmi", "prody", "Bio", "openbabel"],
            "executable": "python",
            "script": "executionpacks/autodock_vina.py",
            "modules": [
              "executionpacks/autodock_vina_inputs.py",
              "executionpacks/autodock_vina_outputs.py",
              "executionpacks/autodock_vina_pockets.py"
            ],
            "cliWitnesses": [
              {"executable": "vina", "arguments": ["--help"]},
              {"executable": "obabel", "arguments": ["-H"]},
              {"executable": "mk_prepare_ligand.py", "arguments": ["--help"]},
              {"executable": "mk_prepare_receptor.py", "arguments": ["--help"]}
            ],
            "inputs": [
              {"kind": "receptor", "argument": "--receptor", "extensions": [".pdb", ".pdbqt", ".cif", ".mmcif"]},
              {"kind": "ligand", "argument": "--ligand", "extensions": [".cdx", ".sdf", ".mol", ".mol2", ".smi", ".smiles", ".pdbqt"]}
            ],
            "parameters": [
              {"name": "reference_ligand", "argument": "--reference-ligand", "type": "string", "required": false},
              {"name": "pocket_selection", "argument": "--pocket-selection", "type": "string", "required": false},
              {"name": "pocket_validation", "argument": "--pocket-validation", "type": "string", "required": false},
              {"name": "report_language", "argument": "--report-language", "type": "string", "required": false, "default": "en", "evidence": "runtime-response-language"},
              {"name": "center_x", "argument": "--center-x", "type": "number", "required": false, "evidence": "resolved-user-input", "evidenceGroup": "binding-site-center", "evidenceTerms": ["binding-site center", "binding pocket", "pocket prediction", "docking center", "grid box center", "box center", "center coordinates", "docking box", "结合位点中心", "结合口袋", "口袋预测", "对接中心", "对接盒子", "盒子中心", "网格中心", "中心坐标"]},
              {"name": "center_y", "argument": "--center-y", "type": "number", "required": false, "evidence": "resolved-user-input", "evidenceGroup": "binding-site-center"},
              {"name": "center_z", "argument": "--center-z", "type": "number", "required": false, "evidence": "resolved-user-input", "evidenceGroup": "binding-site-center"},
              {"name": "center_authority", "argument": "--center-authority", "type": "string", "required": false},
              {"name": "size_x", "argument": "--size-x", "type": "number", "required": false, "minimum": 1, "maximum": 100},
              {"name": "size_y", "argument": "--size-y", "type": "number", "required": false, "minimum": 1, "maximum": 100},
              {"name": "size_z", "argument": "--size-z", "type": "number", "required": false, "minimum": 1, "maximum": 100},
              {"name": "seed", "argument": "--seed", "type": "integer", "required": false, "default": 42, "minimum": 0, "maximum": 2147483647},
              {"name": "repeat_count", "argument": "--repeat-count", "type": "integer", "required": false, "default": 3, "minimum": 1, "maximum": 64},
              {"name": "exhaustiveness", "argument": "--exhaustiveness", "type": "integer", "required": false, "default": 8, "minimum": 1, "maximum": 128},
              {"name": "num_modes", "argument": "--num-modes", "type": "integer", "required": false, "default": 9, "minimum": 1, "maximum": 100}
            ],
            "evidenceResolvers": [
              {"evidenceGroup": "binding-site-center", "skill": "p2rank-pocket-detection", "implementation": "P2Rank"}
            ],
            "outputs": [
              {"kind": "docking-scores", "path": "out/docking_scores.csv", "format": "csv", "delivery": "snapshot", "minBytes": 64, "minRecords": 1},
              {"kind": "docking-pose-scores", "path": "out/docking_pose_scores.csv", "format": "csv", "minBytes": 64, "minRecords": 1},
              {"kind": "docking-pose-samples", "path": "out/docking_pose_samples.csv", "format": "csv", "minBytes": 64, "minRecords": 1},
              {"kind": "ranked-pose", "path": "out/ranked_poses.pdbqt", "format": "text", "delivery": "snapshot", "minBytes": 64},
              {"kind": "docking-complex", "path": "out/docking_complex_ensemble.pdb", "format": "text", "delivery": "snapshot", "minBytes": 64},
              {"kind": "docking-components", "path": "out/docking_components.csv", "format": "csv", "delivery": "snapshot", "minBytes": 64, "minRecords": 1},
              {"kind": "primary-pose-manifest", "path": "out/primary_pose_manifest.csv", "format": "csv", "delivery": "snapshot", "minBytes": 64, "minRecords": 1},
              {"kind": "docking-report", "path": "out/docking_report.md", "format": "text", "delivery": "snapshot", "minBytes": 64},
              {"kind": "execution-log", "path": "out/vina.log", "format": "text", "delivery": "working_data", "minBytes": 32},
              {"kind": "validation-record", "path": "out/validation.json", "format": "json", "delivery": "working_data", "minBytes": 64, "requiredJsonTrue": ["/overall_pass", "/checks/input_fidelity", "/checks/pose_count_fidelity", "/checks/source_integrity", "/checks/output_integrity", "/checks/report_language", "/checks/process_cleanup"]}
            ],
            "comparisons": [
              {"path": "out/docking_scores.csv", "derivedColumns": ["best_affinity_kcal_mol", "rank"], "basisColumns": ["receptor_sha256", "center_x", "center_y", "center_z", "size_x", "size_y", "size_z", "seed", "repeat_count", "exhaustiveness", "num_modes", "poses_per_candidate"]}
            ],
            "scoreKind": "affinity-kcal-mol"
          }
        },
        {
